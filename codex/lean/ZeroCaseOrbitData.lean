import ZeroCaseSymmetry

/-! Finite orbit certificates. Base-three digits 0,1,2 encode -1,0,+1.
The Python-produced tables are only data; every decisive certificate is checked
by Lean's kernel, with no native_decide or external oracle. -/

namespace Conway99

set_option maxRecDepth 100000
set_option maxHeartbeats 16000000

open scoped BigOperators

def decodeRootSignature (n : ℕ) : RootSignature := fun i =>
  ⟨n / 3 ^ (3 - i.val) % 3, Nat.mod_lt _ (by decide)⟩

def encodedSignaturePacking (ns : List ℕ) : Finset RootSignature :=
  (ns.map decodeRootSignature).toFinset

def zeroCaseOrbitRepresentative (j : Fin 5) : Finset RootSignature :=
  ![encodedSignaturePacking [1,15,23,35,45,57,65],
    encodedSignaturePacking [1,15,45,57,80],
    encodedSignaturePacking [5,15,19,55,80],
    encodedSignaturePacking [5,15,45,55,80],
    encodedSignaturePacking [2,15,80]] j

