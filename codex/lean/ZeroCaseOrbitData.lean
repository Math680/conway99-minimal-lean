structure PackingOrbitRow where
  codes : List ℕ
  representative : Fin 5
  permutation : Fin 24
  signs : Fin 16
  deriving DecidableEq

def PackingOrbitRow.packing (r : PackingOrbitRow) : Finset RootSignature :=
  encodedSignaturePacking r.codes

def PackingOrbitRow.symmetry (r : PackingOrbitRow) : SignatureSymmetry :=
  (packingCoordinatePermutation r.permutation,
    fun i => r.signs.val / 2 ^ (3 - i.val) % 2 == 0)

